#include <windows.h>
#include "../src/Gui/resource.h"

1 24 "camtest.manifest"

IDD_MAIN DIALOGEX 0, 0, 320, 210
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "camtest - Fake Webcam"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Number of cameras:", -1, 10, 10, 90, 10
    COMBOBOX        IDC_COUNT_COMBO, 105, 8, 40, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Camera 1", -1, 10, 30, 45, 10
    LTEXT           "(not set)", IDC_PATH_BASE+0, 60, 30, 170, 10, SS_PATHELLIPSIS
    PUSHBUTTON      "Browse...", IDC_BROWSE_BASE+0, 235, 28, 50, 14
    LTEXT           "", IDC_ROWSTATUS_BASE+0, 290, 30, 24, 10

    LTEXT           "Camera 2", -1, 10, 50, 45, 10
    LTEXT           "(not set)", IDC_PATH_BASE+1, 60, 50, 170, 10, SS_PATHELLIPSIS
    PUSHBUTTON      "Browse...", IDC_BROWSE_BASE+1, 235, 48, 50, 14
    LTEXT           "", IDC_ROWSTATUS_BASE+1, 290, 50, 24, 10

    LTEXT           "Camera 3", -1, 10, 70, 45, 10
    LTEXT           "(not set)", IDC_PATH_BASE+2, 60, 70, 170, 10, SS_PATHELLIPSIS
    PUSHBUTTON      "Browse...", IDC_BROWSE_BASE+2, 235, 68, 50, 14
    LTEXT           "", IDC_ROWSTATUS_BASE+2, 290, 70, 24, 10

    LTEXT           "Camera 4", -1, 10, 90, 45, 10
    LTEXT           "(not set)", IDC_PATH_BASE+3, 60, 90, 170, 10, SS_PATHELLIPSIS
    PUSHBUTTON      "Browse...", IDC_BROWSE_BASE+3, 235, 88, 50, 14
    LTEXT           "", IDC_ROWSTATUS_BASE+3, 290, 90, 24, 10

    PUSHBUTTON      "Start", IDC_START, 10, 115, 60, 16
    PUSHBUTTON      "Stop", IDC_STOP, 75, 115, 60, 16

    LTEXT           "Not registered yet.", IDC_STATUS, 10, 140, 300, 20
    PUSHBUTTON      "Register (admin, one-time)", IDC_REGISTER, 10, 165, 140, 16
    PUSHBUTTON      "Unregister", IDC_UNREGISTER, 155, 165, 80, 16
END
